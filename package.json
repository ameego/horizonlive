{
  "name": "horizon",
  "private": true,
  "description": "Horizon website",
  "version": "0.1.0",
  "license": "0BSD",
  "scripts": {
    "build": "GATSBY_EXPERIMENTAL_PAGE_BUILD_ON_DATA_CHANGES=true gatsby build --log-pages",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "cy:open": "cypress open",
    "test:e2e": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test develop http://localhost:8000 cy:open",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1"
  },
  "dependencies": {
    "@browniebroke/gatsby-image-gallery": "^8.2.0",
    "gatsby": "^5.13.3",
    "gatsby-plugin-image": "^3.13.1",
    "gatsby-plugin-netlify-cms": "^7.12.1",
    "gatsby-plugin-sass": "^6.13.1",
    "gatsby-plugin-sharp": "^5.13.1",
    "gatsby-source-filesystem": "^5.13.1",
    "gatsby-transformer-json": "^5.13.1",
    "gatsby-transformer-remark": "^6.13.1",
    "gatsby-transformer-sharp": "^5.13.1",
    "lodash.get": "^4.4.2",
    "marked": "^14.0.0",
    "netlify-cms-app": "^2.14.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-headroom": "^3.1.0",
    "sass": "^1.77.0"
  },
  "devDependencies": {
    "cypress": "^13.0.0",
    "eslint-plugin-cypress": "^3.0.0",
    "netlify-plugin-cypress": "^2.2.1",
    "prettier": "2.0.5",
    "start-server-and-test": "^1.11.7"
  },
  "overrides": {
    "graphql": "^16"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}
